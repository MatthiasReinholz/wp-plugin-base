FOUNDATION_VERSION=v1.9.0
FOUNDATION_REPOSITORY=MatthiasReinholz/wp-plugin-base
AUTOMATION_PROFILE=local
PLUGIN_NAME="Existing Application"
PLUGIN_SLUG=existing-application
MAIN_PLUGIN_FILE=existing-application.php
README_FILE=readme.txt
ZIP_FILE=existing-application.zip
PHP_VERSION=8.1
NODE_VERSION=24
VERSION_CONSTANT_NAME=EXISTING_APPLICATION_VERSION
WORDPRESS_ORG_SLUG=existing-application
ADMIN_UI_PACK_ENABLED=false
REST_OPERATIONS_PACK_ENABLED=false
PLUGIN_RUNTIME_UPDATE_PROVIDER=none
WORDPRESS_READINESS_ENABLED=false
WORDPRESS_QUALITY_PACK_ENABLED=false
BUILD_SCRIPT=tools/build.sh
BUILD_OUTPUTS=build/index.js,build/index.asset.php,build/index.css,build/index-rtl.css,build/licenses.txt
BUILD_OUTPUT_MANIFEST=build/manifest.json
PACKAGE_INCLUDE=existing-application.php,readme.txt,LICENSE,build
